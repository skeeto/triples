<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by CMake from src/Info-iOS.plist.in; edit the template, not the
  build-tree copy. CMake's default MACOSX_BUNDLE Info.plist targets macOS;
  iOS needs LSRequiresIPhoneOS, UIDeviceFamily, supported orientations, and
  (iOS 13+) UILaunchScreen — so we provide a full custom plist here.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>@PROJECT_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>com.nullprogram.@PROJECT_NAME@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Triples</string>
    <key>CFBundleDisplayName</key>
    <string>Triples</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <!--
      iPhone + iPad home-screen icons. CFBundleIconFiles names the PNG
      stems; iOS appends the @2x / @3x suffix and chooses based on the
      device's render scale (so AppIcon60x60 finds AppIcon60x60@2x.png on
      a 2× device and AppIcon60x60@3x.png on a 3× one). The PNG payloads
      are emitted by tools/genicon.cpp's renderTileIOS() — full-bleed,
      no rounded corners, since iOS applies its own squircle mask.
    -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
            </array>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
                <string>AppIcon76x76</string>
            </array>
        </dict>
    </dict>
</dict>
</plist>
